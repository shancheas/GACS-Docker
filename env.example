# GenieACS Docker Environment Variables
# Copy this file to .env and modify as needed
# cp env.example .env

# MongoDB Authentication (CHANGE THESE IN PRODUCTION!)
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=adminpassword

# MongoDB Connection (auto-generated from above credentials)
# Override this if using external MongoDB
# GENIEACS_MONGODB_CONNECTION_URL=mongodb://admin:adminpassword@mongodb:27017/genieacs?authSource=admin

# GenieACS Ports
GENIEACS_CWMP_PORT=7547
GENIEACS_NBI_PORT=7557
GENIEACS_FS_PORT=7567
GENIEACS_UI_PORT=3000

# GenieACS UI JWT Secret (CHANGE THIS IN PRODUCTION!)
GENIEACS_UI_JWT_SECRET=changeme-to-a-secure-random-string

# File Server Hostname (for firmware download URLs)
# GENIEACS_FS_HOSTNAME=your-server-ip-or-hostname

# Data directory for logs and extensions
# DATA_DIR=./data

# Timezone
TZ=Asia/Jakarta

